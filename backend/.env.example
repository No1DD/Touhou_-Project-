# 本機預設使用 SQLite；正式環境請改為 PostgreSQL 或 MySQL URL。
DATABASE_URL=sqlite:///./characters.db
# environment 設為 production 時，缺 JWT_SECRET_KEY 會直接中止啟動。
APP_ENV=development
# JWT 密鑰刻意留白；請自行產生後填入，不存在任何預設 secret。
JWT_SECRET_KEY=
# PostgreSQL 範例：postgresql+psycopg://user:password@localhost:5432/character_database
# MySQL 範例：mysql+pymysql://user:password@localhost:3306/character_database?charset=utf8mb4
# React 前端的網址；如 Vite 改用其他 port，請同步更新。
FRONTEND_ORIGIN=http://localhost:5173
# API 自身 Origin，用於後端 Swagger/Cookie CSRF origin 驗證。
API_ORIGIN=http://localhost:8000
# 多 worker 正式環境可使用 Redis 共用限流計數器；本機單 worker 使用 memory://。
RATE_LIMIT_STORAGE_URI=memory://
# Cloudinary 帳戶中的 Cloud name。
CLOUDINARY_CLOUD_NAME=your-cloud-name
# Cloudinary 帳戶中的 API key。
CLOUDINARY_API_KEY=your-api-key
# Cloudinary 帳戶中的 API secret；實際值不可提交到 Git。
CLOUDINARY_API_SECRET=replace-with-your-api-secret
# Cloudinary 圖片儲存資料夾。
CLOUDINARY_FOLDER=gensokyo/characters
# AI provider 可設為 openai 或 ollama。
AI_PROVIDER=openai
# OpenAI API key；只在 AI_PROVIDER=openai 時需要。
OPENAI_API_KEY=
# 可選的 OpenAI-compatible API base URL；留白時使用官方 API。
OPENAI_BASE_URL=
# 雲端 OpenAI 關係萃取模型名稱。
OPENAI_MODEL=gpt-4o-mini
# Ollama OpenAI-compatible API 位址。
OLLAMA_BASE_URL=http://localhost:11434/v1
# 預先下載的本機 Ollama 模型名稱。
OLLAMA_MODEL=qwen3:8b
