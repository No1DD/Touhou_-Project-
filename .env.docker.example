# Copy this file to .env at the repository root. Do not commit .env.
APP_ENV=development
JWT_SECRET_KEY=
POSTGRES_DB=character_database
POSTGRES_USER=character_app
POSTGRES_PASSWORD=

# Optional image hosting credentials. Leave blank to disable image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=gensokyo/characters

# Choose openai or ollama. OpenAI key is only needed for the openai provider.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen3:8b
